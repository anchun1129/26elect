<view class="container">
  <van-empty wx:if="{{list.length === 0}}" description="暂无上报工单" />

  <scroll-view scroll-y class="scroll-box" wx:else>
    <view class="order-card" wx:for="{{list}}" wx:key="_id">
      <view class="top-row">
        <text class="time">{{item.createTime}}</text>
        <van-tag type="{{item.status === 'pending' ? 'warning' : 'success'}}">
          {{item.status === 'pending' ? '待处理' : '已办结'}}
        </van-tag>
      </view>
      <view class="line">地点：{{item.location}}</view>
      <view class="line">描述：{{item.description || '无'}}</view>
      <view class="img-wrap" wx:if="{{item.imgList.length > 0}}">
        <image
          wx:for="{{item.imgList}}"
          wx:key="*this"
          src="{{item}}"
          class="img"
          mode="aspectFill"
          bindtap="previewImg"
          data-list="{{item.imgList}}"
          data-index="{{index}}"
        ></image>
      </view>
    </view>
  </scroll-view>
</view>