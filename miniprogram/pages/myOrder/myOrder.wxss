page {
  background: #f6f6f6;
  padding: 20rpx;
}
.scroll-box {
  height: 100vh;
}
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.time {
  font-size: 26rpx;
  color: #999;
}
.line {
  font-size: 28rpx;
  line-height: 2;
}
.img-wrap {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
}