<!-- 顶部个人信息区域 -->
<van-image 
  round 
  width="160rpx" 
  height="160rpx" 
  src="https://img.yzcdn.cn/vant/cat.jpeg"
  style="margin: 30rpx 25rpx;"
/>
<view style="margin:0 25rpx 20rpx;">
  <view class="username">居民用户</view>
  <view class="user-id">编号：Jumin001</view>
</view>

<!-- 数据卡片区域 -->
<view style="margin: 0 25rpx;">
  <van-card title="累计上报工单" desc="{{totalNum}} 条" />
  <view style="height:20rpx;"></view>
  <van-card title="已办结工单" desc="{{finishNum}} 条" />
</view>

<!-- 功能菜单列表 Vant Cell分组 -->
<van-cell-group style="margin: 30rpx 25rpx; border-radius: 12rpx; overflow: hidden;">
  <van-cell title="我的上报记录" is-link bind:click="goRecord" />
  <van-cell title="修改个人信息" is-link bind:click="goEditInfo" />
  <van-cell title="使用帮助" is-link bind:click="goHelp" />
  <van-cell title="退出登录" bind:click="logout" />
</van-cell-group>

<!-- 底部版本标注 -->
<view class="version" style="text-align:center; margin-top:80rpx; color:#999; font-size:24rpx;">当前版本：v1.0</view>
<view class="version">当前版本：v1.0</view>

<!-- ========== 添加底部TabBar ========== -->
<van-tabbar active="{{ active }}" bind:change="onChange">
  <van-tabbar-item icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item icon="edit">上报</van-tabbar-item>
  <van-tabbar-item icon="user-o">我的</van-tabbar-item>
</van-tabbar>
