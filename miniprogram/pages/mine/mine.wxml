<!-- 顶部个人信息区域 -->
<view class="user-header">
  <image
    class="avatar-round"
    style="width: 80rpx; height: 80rpx; border-radius: 50%;"
    src="https://img.yzcdn.cn/vant/cat.jpeg"
  />
  <view class="user-info">
    <view class="username">居民用户</view>
    <view class="user-id">编号：Jumin001</view>
  </view>
</view>
<view style="margin: 30rpx 25rpx;">
  <report-card title="累计上报工单" desc="{{totalNum}} 条"></report-card>
  <view style="height:20rpx;"></view>
  <report-card title="已办结工单" desc="{{finishNum}} 条"></report-card>
</view>
<!-- 功能菜单列表（原生view模拟cell分组） -->
<view class="cell-group" style="margin: 0 25rpx; background: #fff; border-radius: 12rpx; overflow: hidden;">
  <view class="cell-item" bind:click="goRecord">
    <text>我的上报记录</text>
    <text class="arrow">></text>
  </view>
  <view class="cell-item" bind:click="goEditInfo">
    <text>修改个人信息</text>
    <text class="arrow">></text>
  </view>
  <view class="cell-item" bind:click="goHelp">
    <text>使用帮助</text>
    <text class="arrow">></text>
  </view>
  <view class="cell-item" bind:click="logout">
    <text>退出登录</text>
  </view>
</view>

<!-- 底部版本标注 -->
<view class="version">当前版本：v1.0</view>