.user-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff3e8;
  margin: 20rpx;
  border-radius: 16rpx;
}
.user-info {
  margin-left: 30rpx;
}
.username {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.user-id {
  font-size: 28rpx;
  color: #888;
}
.version {
  text-align: center;
  margin-top: 40rpx;
  color: #999;
  font-size: 26rpx;
}