.user-header {
  display: flex;
  align-items: center;
  padding: 30rpx 25rpx;
  background-color: #ffffff;
}
.user-info {
  margin-left: 24rpx;
}
.username {
  font-size: 34rpx;
  font-weight: 500;
}
.user-id {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.cell-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
}
.cell-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #c8c9cc;
  font-size: 32rpx;
}
.version {
  text-align: center;
  margin-top: 80rpx;
  font-size: 24rpx;
  color: #aaa;
}