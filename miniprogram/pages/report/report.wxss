/* ========== 页面整体 ========== */
.page-container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 120rpx;
}

.form-wrap {
  padding: 24rpx;
}

/* ========== 卡片 ========== */
.section {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.required {
  color: #F5222D;
  margin-left: 4rpx;
}

/* ========== 图片上传 ========== */
.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F5F7FA;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 28rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #E8E8E8;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
  background: #F5F7FA;
}

.plus {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.upload-tip {
  font-size: 24rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* ========== 地点选择 ========== */
.location-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  min-height: 72rpx;
}

.location-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
}

.location-text.placeholder {
  color: #999999;
}

.location-text.has-value {
  color: #333333;
}

.location-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* ========== 提交按钮 ========== */
.submit-wrap {
  margin-top: 48rpx;
  padding: 0 16rpx;
}

.submit-wrap .van-button {
  border-radius: 48rpx !important;
  background-color: #1677FF !important;
  border-color: #1677FF !important;
  height: 96rpx !important;
  font-size: 34rpx !important;
  font-weight: 500 !important;
}

/* ========== Vant 组件样式覆盖 ========== */
/* 单选按钮选中色 */
.van-radio--checked .van-radio__icon {
  border-color: #1677FF !important;
  background-color: #1677FF !important;
}

/* 文本域字数统计 */
.van-field__word-limit {
  color: #999999 !important;
  font-size: 24rpx !important;
}

/* 文本域占位符 */
.van-field__textarea::placeholder {
  color: #999999 !important;
}