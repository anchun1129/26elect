/* pages/report/report.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx 24rpx 120rpx;
  box-sizing: border-box;
}
.form-wrap {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}
.section {
  margin-bottom: 40rpx;
}
.section-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.required {
  color: #f53f3f;
}

/* 上传图片样式 */
.upload-list {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}
.upload-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
}
.upload-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  border-radius: 50%;
  font-size: 28rpx;
}
.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.plus {
  font-size: 50rpx;
  color: #ccc;
}
.upload-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.upload-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 提交按钮 */
.submit-wrap {
  margin-top: 60rpx;
}