/* pages/home/home.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  /* 底部留出原生tabBar高度，内容不被遮挡 */
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, #4fc3f7 0%, #29b6f6 100%);
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  color: #fff;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 功能卡片 */
.action-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  /* 纯emoji表情，不需要外部字体，杜绝字体加载报错 */
}

.action-info {
  flex: 1;
}

.action-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
}

.action-arrow {
  font-size: 40rpx;
  color: #ccc;
}