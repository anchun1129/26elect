<view class="page-container">
  <!-- 顶部欢迎区 -->
  <view class="welcome-card">
    <view class="welcome-title">你好，居民朋友 👋</view>
    <view class="welcome-desc">发现违规电动车？一键上报，共建安全社区</view>
  </view>

  <!-- 快速上报入口 -->
  <view class="action-card" bindtap="goReport">
    <view class="action-icon">📸</view>
    <view class="action-info">
      <view class="action-title">我要上报</view>
      <view class="action-desc">拍照上传违规电动车，AI自动识别</view>
    </view>
    <view class="action-arrow">›</view>
  </view>

  <!-- 我的上报入口 -->
  <view class="action-card" bindtap="goMine">
    <view class="action-icon">📋</view>
    <view class="action-info">
      <view class="action-title">我的上报</view>
      <view class="action-desc">查看上报记录和处理进度</view>
    </view>
    <view class="action-arrow">›</view>
  </view>
</view>