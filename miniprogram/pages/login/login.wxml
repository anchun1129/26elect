<view class="login-container">
  <!-- 顶部logo区域 -->
  <view class="header">
    <image class="logo" src="/images/logo.jpg" mode="aspectFit"></image> 
    <text class="app-name">违规电动车识别</text>
    <text class="app-slogan">共建安全社区</text>
  </view>

  <!-- 登录按钮区域 -->
  <view class="login-body">
    <button class="login-btn" bindtap="handleLogin" loading="{{ isLoading }}" disabled="{{ isLoading }}">
      <text wx:if="{{ !isLoading }}">微信一键登录</text>
      <text wx:else>登录中...</text>
    </button>
    
    <view class="agreement">
      <text>登录即代表同意</text>
      <text class="link" bindtap="showPrivacy">《隐私政策》</text>
      <text>和</text>
      <text class="link" bindtap="showTerms">《用户协议》</text>
    </view>
  </view>

  <!-- 底部版本信息 -->
  <view class="footer">
    <text>v1.0.0</text>
  </view>
</view>