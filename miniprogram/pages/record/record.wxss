.container {
  padding: 20rpx;
}
.record-item {
  margin-bottom: 24rpx;
}
.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-content {
  font-size: 28rpx;
  line-height: 1.8;
}
.row {
  display: flex;
  margin: 8rpx 0;
}
.label {
  color: #888;
  width: 160rpx;
}
.img-wrap {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.preview-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
}