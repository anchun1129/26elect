<!-- 如果记录数组不为空，展示列表 -->
<view wx:if="{{recordList.length > 0}}" class="container">
  <van-card wx:for="{{recordList}}" wx:key="id" class="record-item">
    <!-- 上报状态标签 -->
    <view slot="title" class="card-title">
      <text>工单{{item.id}}</text>
      <van-tag type="{{item.tagType}}" style="margin-left:10rpx;">{{item.status}}</van-tag>
    </view>
<!-- 时间格式化过滤器 -->
<wxs module="tool">
  var formatDate = function(dateStr) {
    if (!dateStr) return '';
    var date = getDate(dateStr);
    var year = date.getFullYear();
    var month = date.getMonth() + 1;
    var day = date.getDate();
    var hours = date.getHours();
    var minutes = date.getMinutes();
    month = month < 10 ? '0' + month : month;
    day = day < 10 ? '0' + day : day;
    minutes = minutes < 10 ? '0' + minutes : minutes;
    return year + '-' + month + '-' + day + ' ' + hours + ':' + minutes;
  }
  module.exports = {
    formatDate: formatDate
  };
</wxs>

<view style="padding: 20rpx;">
  <view wx:if="{{recordList.length > 0}}">
    <!-- 循环列表 -->
    <view wx:for="{{recordList}}" wx:key="_id" style="border: 1px solid #e0e0e0; padding: 20rpx; margin-bottom: 20rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);">
      
      <!-- 第一行：工单号和状态 -->
      <view style="display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx;">
        <text>工单#{{index + 1}}</text>

        <!-- 状态标签 (修正居中和颜色) -->
        <view style="padding: 6rpx 18rpx; border-radius: 30rpx; font-size: 24rpx; color: #fff; 
          display: flex; align-items: center; justify-content: center; height: 40rpx; line-height: 40rpx;
          background: {{item.status === '已处理' ? '#07c160' : '#ff976a'}};">
          {{item.status}}
        </view>
      </view>

      <!-- 中间数据区 -->
      <view style="font-size: 28rpx; color: #666; line-height: 1.6;">
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">问题类型：</text>
          <text style="flex: 1;">{{item.type || '暂无类型'}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">上报地址：</text>
          <text style="flex: 1;">{{item.address || '暂无地址'}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">问题描述：</text>
          <text style="flex: 1;">{{item.desc}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">提交时间：</text>
          <!-- 【调用 WXS 过滤器处理时间】 -->
          <text style="flex: 1;">{{tool.formatDate(item.createTime)}}</text>
        </view>
      </view>

    <!-- 图片预览，有多张图就循环展示 -->
    <view class="img-wrap" wx:if="{{item.images && item.images.length>0}}">
      <image
        wx:for="{{item.images}}"
        wx:key="*this"
        class="preview-img"
        src="{{item}}"
        mode="aspectFill"
        bindtap="previewImage"
        data-src="{{item}}"
      />
    </view>
  </view>

  <!-- 没数据时的展示 -->
  <view wx:else style="text-align: center; color: #999; margin-top: 100rpx; font-size: 28rpx;">
    还没有上报记录
  </view>
</view>