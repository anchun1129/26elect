<view style="padding: 20rpx;">
  <view wx:if="{{recordList.length > 0}}">
    <!-- 循环列表 -->
    <view wx:for="{{recordList}}" wx:key="_id" style="border: 1px solid #e0e0e0; padding: 20rpx; margin-bottom: 20rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);">
      
      <!-- 第一行：工单号和状态 -->
      <view style="display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx;">
        <text>工单#{{index + 1}}</text>

        <!-- 状态标签 -->
        <view style="padding: 6rpx 18rpx; border-radius: 30rpx; font-size: 24rpx; color: #fff; 
          display: flex; align-items: center; justify-content: center; height: 40rpx; line-height: 40rpx;
          background: {{item.status === '已处理' ? '#07c160' : '#ff976a'}};">
          {{item.status}}
        </view>
      </view>

      <!-- 中间数据区 -->
      <view style="font-size: 28rpx; color: #666; line-height: 1.6;">
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">问题类型：</text>
          <text style="flex: 1;">{{item.violationType || '电动车违停'}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">上报地址：</text>
          <text style="flex: 1;">{{item.location || '暂无地址'}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">问题描述：</text>
          <text style="flex: 1;">{{item.description || item.desc}}</text>
        </view>
        <view style="display: flex; margin-bottom: 8rpx;">
          <text style="width: 140rpx; color: #999;">提交时间：</text>
          <text style="flex: 1;">{{item.createTime}}</text>
        </view>
      </view>

      <!-- ========================================= -->
      <!-- 【新增】图片展示与预览区域                     -->
      <!-- ========================================= -->
      <!-- 注意：如果数据里没有imgFileIds或者为空，wx:if 会让它隐藏 -->
      <view class="img-wrap" wx:if="{{item.imgFileIds && item.imgFileIds.length > 0}}" style="display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; border-top: 1px dashed #eee; padding-top: 16rpx;">
        <image
          wx:for="{{item.imgFileIds}}"
          wx:key="*this"
          class="preview-img"
          src="{{item}}"
          mode="aspectFill"
          style="width: 160rpx; height: 160rpx; border-radius: 8rpx; background: #f5f5f5;"
          bindtap="previewImage"
          data-src="{{item}}"
          data-list="{{item.imgFileIds}}"
          data-index="{{index}}"
        />
      </view>

    </view>
  </view>

  <!-- 没数据时的展示 -->
  <view wx:else style="text-align: center; color: #999; margin-top: 100rpx; font-size: 28rpx;">
    还没有上报记录
  </view>
</view>