/* pages/admin/admin.wxss */
page {
  background-color: #f5f5f5;
  padding: 10rpx;
}

/* Tab栏样式 */
.tab-wrap {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
}
.tab-item.active {
  color: #ff9500;
  font-weight: bold;
  border-bottom: 4rpx solid #ff9500;
}

.order-list {
}
.order-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.order-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.order-desc,
.order-time {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.empty-box {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}
.loading-wrap{
  padding:100rpx 0;
  text-align:center;
}
.card-btn-group{
  display:flex;
  gap:16rpx;
  margin-top:20rpx;
  justify-content:flex-end;
}
.popup-content{
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
}
.popup-title{
  font-size:32rpx;
  font-weight:bold;
  text-align:center;
  margin-bottom:30rpx;
}
.upload-tip{
  margin:20rpx 0 10rpx;
  font-size:28rpx;
  color:#666;
}
.btn-row{
  display:flex;
  gap:20rpx;
  margin-top:30rpx;
}
.btn-row van-button{
  flex:1;
}
.status-tag{
  display: inline-block;
  padding:6rpx 16rpx;
  border-radius:8rpx;
  font-size:24rpx;
  color:#fff;
  margin:10rpx 0;
}
.tag-warning{
  background-color:#ff976a;
}
.tag-primary{
  background-color:#1989fa;
}
.tag-success{
  background-color:#07c160;
}


