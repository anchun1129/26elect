/* pages/admin/admin.wxss */
page {
  background-color: #f5f5f5;
  padding: 10rpx;
}

/* Tab栏样式 */
.tab-wrap {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
}
.tab-item.active {
  color: #ff9500;
  font-weight: bold;
  border-bottom: 4rpx solid #ff9500;
}

.order-list {
}
.order-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.order-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.order-desc,
.order-time {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.empty-box {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}

