/* pages/admin/detail/detail.wxss */
.container {
  padding: 20rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}
.operate-box{
  margin:20rpx;
  background:#fff;
  border-radius:12rpx;
  padding:30rpx;
}
.title{
  font-size:32rpx;
  font-weight:bold;
  margin-bottom:20rpx;
}
.row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20rpx 0;
  border-bottom:1rpx solid #eee;
}
textarea{
  border:1rpx solid #eee;
  width:100%;
  min-height:120rpx;
  margin:20rpx 0;
  padding:20rpx;
  border-radius:8rpx;
}
.save-btn{
  margin-top:20rpx;
}
.right-text{
  color:#999;
}
.finished-tip{
  margin:30rpx 20rpx;
  text-align:center;
  color:#07c160;
  font-size:30rpx;
}
