.container{
  padding:20rpx;
}
.card{
  background:#fff;
  padding:30rpx;
  border-radius:16rpx;
}
.row{
  margin:20rpx 0;
}
.action-bar{
  display:flex;
  gap:20rpx;
  margin-top:40rpx;
}
.popup-box{
  padding:30rpx;
}
.btn-group{
  display:flex;
  margin-top:30rpx;
  gap:20rpx;
}
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-box {
  width: 80%;
  background: #fff;
  border-radius:12rpx;
  padding:30rpx;
}
.popup-title {
  font-size:32rpx;
  text-align:center;
  margin-bottom:20rpx;
}
textarea {
  border:1rpx solid #eee;
  width:100%;
  height:150rpx;
  padding:15rpx;
  box-sizing: border-box;
}
.popup-btns {
  display:flex;
  margin-top:20rpx;
  gap:20rpx;
}
.popup-btns button {
  flex:1;
}
