.stats-page {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.card-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  color: #333;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.stat-num.highlight {
  color: #1989fa;
}

.stat-num.warn {
  color: #ee0a24;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 10rpx;
}
